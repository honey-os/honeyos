# HoneyOS Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# Application
# =============================================================================
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=false

# Set to true to prevent all configuration changes via the UI/API.
# Login/logout still works. Manage honeypots via *_HONEYPOT_ENABLED env vars.
# READ_ONLY=false

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=sqlite:///honeyos.db

# =============================================================================
# Network Configuration
# =============================================================================
NETWORK_INTERFACE=eth0
DEFAULT_HONEYPOT_IP=0.0.0.0
PORT_RANGE_START=2000
PORT_RANGE_END=9999

# =============================================================================
# Alert Configuration (Optional)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=HoneyOS Alerts <alerts@honeyos.local>

# Slack Webhook (Optional)
SLACK_WEBHOOK_URL=

# Generic Webhook (Optional)
WEBHOOK_URL=

# =============================================================================
# Geolocation
# =============================================================================
# Uses ip-api.com (free, no API key needed). Set to false to disable.
GEOIP_ENABLED=true

# =============================================================================
# Security
# =============================================================================
SESSION_TIMEOUT_HOURS=168
MAX_EVENTS_PER_IP_PER_MINUTE=100
ENABLE_IP_BLOCKING=true

# =============================================================================
# Connection Throttling
# =============================================================================
# After this many events from one IP on a single protocol, block new
# connections from that IP on that protocol for THROTTLE_BLOCK_SECONDS.
# THROTTLE_EVENT_THRESHOLD=5000
# THROTTLE_BLOCK_SECONDS=3600

# =============================================================================
# Monitoring
# =============================================================================
LOG_LEVEL=INFO
METRICS_ENABLED=true
RETENTION_DAYS=365

# =============================================================================
# TLS Configuration
# =============================================================================
# Default is self-signed HTTPS (TLS_CERT=internal).
# For plain HTTP (no TLS):
#   TLS_CERT=off
# For custom certs:
#   TLS_CERT=/data/certs/honeyos.pem
#   TLS_KEY=/data/certs/honeyos.key
# For auto Let's Encrypt (requires public domain + ports 80/443):
#   TLS_CERT=honeyos.example.com
TLS_CERT=internal
TLS_KEY=

# =============================================================================
# Frontend
# =============================================================================
FRONTEND_PORT=7777
POSTGRESQL_HONEYPOT_PORT=5433
SMB_HONEYPOT_PORT=4450

# FTP passive mode: set to the host/public IP so PASV responses are reachable.
# Leave empty for non-Docker setups (auto-detects from socket).
FTP_PASV_ADDRESS=
NEXT_PUBLIC_API_URL=http://localhost:7778

# =============================================================================
# Honeypot Enable/Disable (all default to true)
# Set to "false" to prevent a honeypot from starting at the infrastructure level.
# The database enabled field is not modified, so removing the var restores normal behavior.
# =============================================================================
# SSH_HONEYPOT_ENABLED=true
# HTTP_HONEYPOT_ENABLED=true
# HTTPS_HONEYPOT_ENABLED=true
# TELNET_HONEYPOT_ENABLED=true
# FTP_HONEYPOT_ENABLED=true
# MYSQL_HONEYPOT_ENABLED=true
# POSTGRESQL_HONEYPOT_ENABLED=true
# DNS_HONEYPOT_ENABLED=true
# SMB_HONEYPOT_ENABLED=true
